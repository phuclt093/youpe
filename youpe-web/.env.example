# Client InnerTube dùng để lấy stream. Thử theo thứ tự nếu bị 403:
# IOS | ANDROID | WEB | TV_EMBEDDED | MWEB
YT_CLIENT=TV_EMBEDDED

# Ngôn ngữ & vùng cho feed
YT_LANG=vi
YT_REGION=VN

# (Tuỳ chọn) Proxy HTTP cho request tới YouTube
# HTTP_PROXY=

# Instance dự phòng khi InnerTube bị SABR-gate (ngăn cách bằng dấu phẩy).
# Bỏ trống để dùng danh sách mặc định trong src/lib/piped.ts
# PIPED_INSTANCES=https://pipedapi.kavin.rocks,https://pipedapi.adminforge.de
# INVIDIOUS_INSTANCES=https://inv.nadeko.net,https://yewtu.be

# ---- yt-dlp (tầng trích xuất chính, khuyến nghị cài) ----
# Đường dẫn tới yt-dlp nếu không nằm trong PATH
# YTDLP_PATH=C:\tools\yt-dlp.exe

# Mượn cookie từ trình duyệt — giúp vượt kiểm tra bot hiệu quả nhất.
# Giá trị: chrome | firefox | edge | brave | chromium | opera | vivaldi | safari
# Nhớ ĐÓNG trình duyệt trước khi chạy, nếu không sẽ bị khoá file cookie.
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Hoặc dùng file cookies.txt xuất sẵn
# YTDLP_COOKIES_FILE=C:\tools\cookies.txt

# Ghim player client của YouTube. Bỏ trống (mặc định) là để yt-dlp tự chọn —
# gần như luôn đúng. Chỉ đặt khi video kẹt ở 360p: chạy `npm run probe -- <videoId>`
# để biết client nào còn sống rồi điền vào đây.
# YTDLP_PLAYER_CLIENT=tv_embedded,android_vr

# Tham số thêm cho yt-dlp
# YTDLP_ARGS=
# YTDLP_TIMEOUT_MS=45000

# Thời gian chờ mỗi kết nối của yt-dlp (giây). Hạ xuống nếu hay bị treo lâu.
# YTDLP_SOCKET_TIMEOUT=5

# ---- Lưu trữ tài khoản ----
# auto (mặc định) = có TURSO_DATABASE_URL thì dùng Turso, không thì SQLite
#                   (cần Node >= 22.5), cuối cùng mới tới file JSON
# turso | sqlite | json = ép dùng đúng cái đó
# DB_DRIVER=auto

# ---- Chạy làm máy chủ đồng bộ cho những máy khác ----
# Chỉ đặt trên server dùng chung, KHÔNG đặt trên máy cá nhân.
# Có biến này thì:
#   - bật CORS cho các origin liệt kê (endpoint tài khoản + thư viện)
#   - cookie phiên chuyển sang SameSite=None; Secure -> server BẮT BUỘC chạy HTTPS
# Giá trị "local" cho phép mọi http://localhost:<cổng> — cần cho app desktop,
# vì vỏ Electron xin cổng trống mỗi lần chạy nên origin đổi liên tục.
# YOUPE_ALLOW_ORIGINS=local,https://youpe.vidu.com

# Địa chỉ máy chủ đồng bộ mặc định, nhúng vào bản build.
# Người dùng vẫn đổi được trong Cài đặt. Bỏ trống = dùng server trên máy.
# NEXT_PUBLIC_YOUPE_API_URL=https://youpe.vidu.com

# ---- Turso (cơ sở dữ liệu trên cloud, dùng chung mọi thiết bị) ----
# Tạo miễn phí ở https://turso.tech — xem docs/CONTEXT.md mục 7 cho các bước cụ thể.
# Điền hai dòng này là app tự chuyển sang dùng Turso, không cần sửa gì thêm.
# TURSO_DATABASE_URL=libsql://ten-db-tai-khoan.turso.io
# TURSO_AUTH_TOKEN=

# Lệnh Python dùng cho worker thường trú (bỏ trống để tự dò).
# Cài "pip install yt-dlp" rồi để trống là đủ — nhanh hơn hẳn file exe.
# YTDLP_PYTHON=python
